{
	"WTF_VERSION": "4.2",
	"CREDITS": "Sephellive, Igigog, folk, Lasse Scheyde",
	"cb_pack": "assault",
	"repeat_timeout": 604800,
	"preconditions": [
		"$ db.actor:character_rank() >= 2500",
		"$ cb_wtf_combat.pack_available('assault')",
		"$ cb_wtf_combat.offer_slot(|CACHE.task_giver_id|, 1, 4)",
		"$ cb_wtf_combat.base_assault_ready(|CACHE.task_giver_id|, 'agr_smart_terrain_1_6', 'army')"
	],
	"entities": [
		{
			"id": "$ cb_wtf_combat.smart_id('agr_smart_terrain_1_6')",
			"name": "$ cb_wtf_combat.smart_name(|this.id|)",
			"CONTROLLER": "@$ igi_target_assault.Assault",
			"link_id": "smart",
			"to_description": true
		},
		{
			"section_name": "bar_darklab_documents",
			"id": "init$ igi_helper.create_on_smart(|this.section_name|, |smart.id|)",
			"CONTROLLER": "@$ igi_target_return.Return",
			"cleanup": "on_fail$ cb_wtf_combat.release_if_exists(|this.id|)",
			"link_id": "documents"
		}
	],
	"rewarder": "@$ cb_wtf_combat.reward(7200, 12)",
	"icon": "ui_inGame2_PD_Lider",
	"quest_givers": [{"Leader": true}, {"Trader": true}]
}
