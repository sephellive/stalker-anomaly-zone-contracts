{
	"WTF_VERSION": "4.2",
	"CREDITS": "Sephellive, Igigog, folk, Lasse Scheyde",
	"cb_pack": "patrol",
	"repeat_timeout": 216000,
	"preconditions": [
		"$ db.actor:character_rank() >= 1500",
		"$ cb_wtf_combat.has_valid_smarts(|smart_a.ids|, 2)",
		"$ cb_wtf_combat.pack_available('patrol')",
		"$ cb_wtf_combat.offer_slot(|CACHE.task_giver_id|, 4, 8)"
	],
	"entities": [
		{
			"ids": "$ igi_finder.get_smarts(0,1)",
			"id": "$ wtf.shuffle(|this.ids|)[1] or 0",
			"name": "$ cb_wtf_combat.smart_name(|this.id|)",
			"link_id": "smart_a",
			"to_description": true
		},
		{
			"ids": "$ igi_finder.get_smarts(0,1)",
			"id": "$ cb_wtf_combat.pick_smart(|this.ids|, |smart_a.id|)",
			"name": "$ cb_wtf_combat.smart_name(|this.id|)",
			"link_id": "smart_b",
			"to_description": true
		},
		{
			"faction": "$ igi_macros.Faction(|CACHE.task_giver_id|, 'enemy of actor and enemy of taskgiver')",
			"section_name": "$ cb_wtf_combat.squad_section(|this.faction|, 0)",
			"id": "init$ utils_obj.create_squad(|this.section_name|, |smart_a.name|).id",
			"init": "init$ igi_helper.init_squad(|this.id|)",
			"CONTROLLER": "@$ igi_target_kill.Kill",
			"to_description": true
		},
		{
			"faction": "$ igi_macros.Faction(|CACHE.task_giver_id|, 'enemy of actor and enemy of taskgiver')",
			"section_name": "$ cb_wtf_combat.squad_section(|this.faction|, 0)",
			"id": "init$ utils_obj.create_squad(|this.section_name|, |smart_b.name|).id",
			"init": "init$ igi_helper.init_squad(|this.id|)",
			"CONTROLLER": "@$ igi_target_kill.Kill",
			"to_description": true
		}
	],
	"rewarder": "@$ cb_wtf_combat.reward(3800, 7)",
	"icon": "ui_inGame2_PD_Lider",
	"quest_givers": [
		{"Leader": true}
	]
}
