-- Small compatibility layer for the Custom Base WTF combat task pack.
-- It only selects existing GAMMA squad sections and never modifies WTF itself.

local faction_prefix = {
	stalker  = "stalker",
	bandit   = "bandit",
	dolg     = "duty",
	freedom  = "freedom",
	killer   = "merc",
	army     = "army",
	ecolog   = "ecolog",
	csky     = "csky",
	monolith = "monolith",
	zombied  = "zombied",
	renegade = "renegade",
	greh     = "greh",
	isg      = "isg",
}

local tier_name = {
	[1] = "novice",
	[2] = "advanced",
	[3] = "veteran",
}

local pack_rules = {
	patrol   = {max_active = 2, cooldown = 43200},
	assault  = {max_active = 1, cooldown = 259200},
	defense  = {max_active = 1, cooldown = 172800},
	science  = {max_active = 2, cooldown = 86400},
	fieldwork = {max_active = 2, cooldown = 28800},
}

local pack_state = {last_finish = {}}

function on_game_start()
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
	igi_callbacks.add_callback("on_finish", on_task_finish)
end

function save_state(m_data)
	m_data.cb_wtf_combat_pack_state = pack_state
end

function load_state(m_data)
	pack_state = m_data.cb_wtf_combat_pack_state or {last_finish = {}}
	pack_state.last_finish = pack_state.last_finish or {}
end

function on_task_finish(CACHE)
	if not CACHE or not CACHE.cb_pack then return end
	if CACHE.status ~= igi_subtask.TASK_STATUSES.FAILED then
		pack_state.last_finish[CACHE.cb_pack] = game.get_game_time()
	end
end

local function actor_tier()
	local rank = db.actor:character_rank()
	if rank >= 8000 then
		return 3
	elseif rank >= 3000 then
		return 2
	end
	return 1
end

function squad_section(faction, tier_offset)
	local tier = actor_tier() + (tonumber(tier_offset) or 0)
	tier = math.max(1, math.min(3, tier))
	local prefix = faction_prefix[faction] or "bandit"
	return prefix .. "_sim_squad_" .. tier_name[tier]
end

function pick_smart(ids, excluded_id)
	local candidates = {}
	for _, id in pairs(ids or {}) do
		if type(id) == "number" and id ~= excluded_id and alife_object(id) then
			candidates[#candidates + 1] = id
		end
	end
	if #candidates == 0 then
		return type(excluded_id) == "number" and excluded_id or 0
	end
	return wtf.shuffle(candidates)[1]
end

function has_valid_smarts(ids, required)
	local seen = {}
	local count = 0
	for _, id in pairs(ids or {}) do
		if type(id) == "number" and not seen[id] and alife_object(id) then
			seen[id] = true
			count = count + 1
			if count >= (tonumber(required) or 1) then
				return true
			end
		end
	end
	return false
end

-- WTF resolves linked entity fields before evaluating task preconditions.
-- Keep an empty/stale smart list harmless, then let the JSON precondition
-- reject the task before any init$ entity is spawned.
function smart_name(id)
	local numeric_id = tonumber(id) or 0
	local smart = alife_object(numeric_id) or alife_object(0)
	return smart and smart:name() or "actor"
end

function smart_id(name)
	local smart = SIMBOARD.smarts_by_names[name]
	return smart and smart.id or 0
end

function smart_exists(name)
	local id = smart_id(name)
	return id ~= 0 and alife_object(id) ~= nil
end

function pack_available(pack)
	local rule = pack_rules[pack]
	if not rule then return false end

	local active_in_pack = 0
	local active_total = 0
	for _, CACHE in pairs(igi_generic_task.TASKS_CACHE or {}) do
		if CACHE.cb_pack then
			active_total = active_total + 1
			if CACHE.cb_pack == pack then
				active_in_pack = active_in_pack + 1
			end
		end
	end

	if active_total >= 5 or active_in_pack >= rule.max_active then
		return false
	end

	local last_finish = pack_state.last_finish[pack]
	if last_finish and game.get_game_time():diffSec(last_finish) < rule.cooldown then
		return false
	end
	return true
end

function offer_slot(task_giver_id, slot, slots)
	local _, month, day = game.get_game_time():get()
	local seed = (tonumber(task_giver_id) or 0) + (tonumber(month) or 0) * 31 + (tonumber(day) or 0)
	return (seed % (tonumber(slots) or 1)) + 1 == (tonumber(slot) or 1)
end

function reward(money, goodwill)
	local factor = 0.75
	if cb_wtf_combat_balance and cb_wtf_combat_balance.money_factor then
		factor = tonumber(cb_wtf_combat_balance.money_factor) or factor
	end
	return igi_rewards.Static({
		money = math.floor((tonumber(money) or 0) * factor),
		goodwill = tonumber(goodwill) or 0,
	})
end

function task_giver_enemy_of(task_giver_id, faction)
	local actor_faction = character_community(db.actor)
	local giver_faction = igi_helper.get_community_by_id(task_giver_id)
	return actor_faction and giver_faction
		and game_relations.is_factions_enemies(actor_faction, faction)
		and game_relations.is_factions_enemies(giver_faction, faction)
end

local function squad_is_assault_target(squad, smart_id, faction)
	if not squad or not squad.squad_members then return false end
	local section = squad:section_name() or ""
	if section:find("tushkano") or section:find("rat") then return false end
	if squad:get_squad_community() ~= faction then return false end
	local scripted_target = squad:get_script_target()
	if scripted_target then return scripted_target == smart_id end
	return squad.current_target_id == smart_id and squad.current_action == 1
end

function base_assault_ready(task_giver_id, smart_name, faction)
	if not task_giver_enemy_of(task_giver_id, faction) then return false end
	local target_id = smart_id(smart_name)
	local smart = SIMBOARD.smarts[target_id]
	if not smart then return false end
	for squad_id in pairs(smart.squads or {}) do
		if squad_is_assault_target(alife_object(squad_id), target_id, faction) then
			return true
		end
	end
	return false
end

function release_if_exists(id)
	local obj = type(id) == "number" and alife_object(id)
	if obj then alife_release(obj) end
	return true
end

function give_item(section, amount)
	if not section or not ini_sys:section_exist(section) then return false end
	for _ = 1, math.max(1, tonumber(amount) or 1) do
		alife_create_item(section, alife_object(0))
	end
	return true
end

function choose_existing(sections, fallback)
	local valid = {}
	for _, section in pairs(sections or {}) do
		if ini_sys:section_exist(section) then
			valid[#valid + 1] = section
		end
	end
	if #valid == 0 then return fallback or "bandage" end
	return valid[math.random(#valid)]
end

function delivery_amount(section)
	if section == "bandage" then return 12 end
	if section == "medkit" then return 6 end
	if section == "antirad" then return 4 end
	return 6
end

function defense_ready(target_smart, spawn_smart, sections)
	if not smart_exists(target_smart) or not smart_exists(spawn_smart) then
		return false
	end
	for _, section in ipairs(sections or {}) do
		if type(section) ~= "string" or not ini_sys:section_exist(section) then
			return false
		end
	end
	return true
end

local function cache_for_entity(entity)
	for _, CACHE in pairs(igi_generic_task.TASKS_CACHE or {}) do
		for _, candidate in ipairs(CACHE.entities or {}) do
			if candidate == entity then return CACHE end
		end
	end
end

local function defense_sender(entity)
	local CACHE = cache_for_entity(entity)
	local giver = CACHE and alife_object(CACHE.task_giver_id)
	if giver then
		return game.translate_string(giver:character_name()), giver:character_icon()
	end
	return game.translate_string(entity.sender_name or "bar_petrenko_name"),
		entity.sender_icon or "ui_inGame2_petrenko"
end

local function send_defense_tip(entity, text_id)
	if not text_id then return end
	local name, icon = defense_sender(entity)
	dynamic_news_helper.send_tip(game.translate_string(text_id), name, nil, 10, icon, nil, "npc")
end

local function squad_alive(id)
	local squad = type(id) == "number" and alife_object(id)
	return squad and squad.commander_id and squad:commander_id() and squad or nil
end

local function retarget_squad(squad, target_smart)
	if not squad then return end
	squad.scripted_target = target_smart
	squad.rush = true
	squad.rush_to_target = true
end

local function arm_rpg_operator(squad)
	if not squad or not ini_sys:section_exist("wpn_rpg7") then return end
	for member in squad:squad_members() do
		local npc = alife_object(member.id)
		if npc then
			alife_create_item("wpn_rpg7", npc)
			if ini_sys:section_exist("ammo_og-7b") then
				alife_create_item("ammo_og-7b", npc)
			end
			return
		end
	end
end

local function section_needs_rpg(entity, section)
	for _, rpg_section in ipairs(entity.rpg_sections or {}) do
		if rpg_section == section then return true end
	end
	return false
end

local function active_defense_squads(entity)
	local active = {}
	for _, id in ipairs(entity.squad_ids or {}) do
		local squad = squad_alive(id)
		if squad then
			retarget_squad(squad, entity.target_smart)
			active[#active + 1] = id
		end
	end
	entity.squad_ids = active
	return #active
end

local function spawn_defense_squad(entity, section)
	local source = SIMBOARD:get_smart_by_name(entity.spawn_smart)
	if not source then return false end
	local squad = SIMBOARD:create_squad(source, section)
	if not squad then return false end
	retarget_squad(squad, entity.target_smart)
	if section_needs_rpg(entity, section) then arm_rpg_operator(squad) end
	entity.squad_ids[#entity.squad_ids + 1] = squad.id
	entity.spawned = entity.spawned + 1
	return true
end

local function fill_defense_front(entity)
	local active = active_defense_squads(entity)
	local limit = math.max(1, tonumber(entity.max_active) or 3)
	while active < limit and entity.spawned < #entity.sections do
		local section = entity.sections[entity.spawned + 1]
		if not spawn_defense_squad(entity, section) then break end
		active = active + 1
	end
	return active
end

local function actor_near_defense_smart(entity, radius)
	if not db.actor or level.name() ~= entity.level_name then return false end
	local smart = SIMBOARD:get_smart_by_name(entity.target_smart)
	if not smart then return false end
	local target = level.object_by_id(smart.id)
	local position = target and target:position() or smart.position
	return position and db.actor:position():distance_to_sqr(position) <= radius * radius
end

local function cleanup_defense_squads(entity)
	for _, id in ipairs(entity.squad_ids or {}) do
		local squad = squad_alive(id)
		if squad then SIMBOARD:remove_squad(squad) end
	end
	entity.squad_ids = {}
end

HeavyDefense = {}

function HeavyDefense.on_init(entity)
	igi_helper.trace_assert(type(entity.level_name) == "string", "HeavyDefense: level_name is missing", entity)
	igi_helper.trace_assert(type(entity.target_smart) == "string", "HeavyDefense: target_smart is missing", entity)
	igi_helper.trace_assert(type(entity.spawn_smart) == "string", "HeavyDefense: spawn_smart is missing", entity)
	igi_helper.trace_assert(type(entity.sections) == "table" and #entity.sections > 0,
		"HeavyDefense: sections are missing", entity)
	entity.stage = entity.stage or 0
	entity.spawned = entity.spawned or 0
	entity.squad_ids = entity.squad_ids or {}
end

function HeavyDefense.status(entity)
	entity.stage = entity.stage or 0
	entity.spawned = entity.spawned or 0
	entity.squad_ids = entity.squad_ids or {}

	if entity.stage == 0 then
		local trigger_radius = math.max(5, tonumber(entity.trigger_radius) or 45)
		if not actor_near_defense_smart(entity, trigger_radius) then
			return igi_subtask.TASK_STATUSES.RUNNING
		end
		entity.stage = 1
		send_defense_tip(entity, entity.warning_text)
		fill_defense_front(entity)
	end

	local hold_radius = math.max(100, tonumber(entity.hold_radius) or 320)
	if not actor_near_defense_smart(entity, hold_radius) then
		cleanup_defense_squads(entity)
		return igi_subtask.TASK_STATUSES.FAILED
	end

	local active = fill_defense_front(entity)
	if not entity.mid_sent and entity.spawned >= math.ceil(#entity.sections / 2) then
		entity.mid_sent = true
		send_defense_tip(entity, entity.reinforcement_text)
	end
	if entity.spawned >= #entity.sections and active == 0 then
		return igi_subtask.TASK_STATUSES.COMPLETED
	end
	return igi_subtask.TASK_STATUSES.RUNNING
end

function HeavyDefense.quest_target(entity)
	return smart_id(entity.target_smart)
end

function HeavyDefense.complexity(entity)
	return math.max(6000, #(entity.sections or {}) * 4500)
end

function HeavyDefense.get_description(entity)
	local text_id = entity.stage == 1 and entity.fight_text or entity.prepare_text
	return {targets = {game.translate_string(text_id)}}
end

function HeavyDefense.on_fail(entity)
	cleanup_defense_squads(entity)
	send_defense_tip(entity, entity.failure_text)
end

LevelVisit = {}

function LevelVisit.on_init(entity)
	igi_helper.trace_assert(type(entity.level_name) == "string", "LevelVisit: level_name is missing", entity)
end

function LevelVisit.status(entity)
	if level.name() == entity.level_name then
		return igi_subtask.TASK_STATUSES.COMPLETED
	end
	return igi_subtask.TASK_STATUSES.RUNNING
end

function LevelVisit.quest_target(entity)
	return -1
end

function LevelVisit.complexity(entity)
	return 1200
end

function LevelVisit.get_description(entity)
	return {targets = {game.translate_string(entity.target_text)}}
end
