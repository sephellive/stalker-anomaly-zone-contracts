		{"section_name": "monolith_sim_squad_advanced", "id": "init$ utils_obj.create_squad(|this.section_name|, |smart.name|).id", "init": "init$ igi_helper.init_squad(|this.id|)", "CONTROLLER": "@$ igi_target_kill.Kill", "cleanup": "on_fail$ cb_wtf_combat.release_if_exists(|this.id|)", "to_description": true}
